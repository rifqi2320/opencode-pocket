{
  "expo": {
    "name": "OpenCode Pocket",
    "slug": "pocket-control",
    "owner": "reefz23",
    "version": "0.1.1-rc.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "opencode-pocket",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.pocketcontrol.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "app.pocketcontrol.mobile",
      "versionCode": 6,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "name": "OpenCode Pocket",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#17241e",
          "defaultChannel": "pocket-attention"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "19fe215a-5a10-47f4-abb5-0aaefb9c8238"
      }
    }
  }
}
